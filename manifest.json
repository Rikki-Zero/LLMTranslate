{
  "manifest_version": 3,
  "name": "LLM Pipeline",
  "version": "0.0.1",
  "description": "使用OpenAI API进行文本处理的浏览器扩展",
  "author": "Rikki",
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "background": {
    "scripts": ["src/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"], 
      "js": ["src/content.ts"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_icon": {
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "LLM Pipeline",
    "default_popup": "src/popup.html"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  }
}
