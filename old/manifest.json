{
  "manifest_version": 2,
  "name": "LLM Translator",
  "version": "1.0",
  "description": "使用OpenAI API进行文本翻译的Firefox扩展",
  "icons": {
    "48": "icons/icon-48.png"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "clipboardWrite",
    "management"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "browser_action": {
    "default_icon": "icons/icon-32.png",
    "default_title": "LLM Translator",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
